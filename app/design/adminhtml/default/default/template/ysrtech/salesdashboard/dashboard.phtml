                    <th><?php echo $this->__('Order') ?></th><th><?php echo $this->__('Invoice / Credit memo') ?></th><th><?php echo $this->__('Gateway transaction') ?></th>
                    <th class="a-right"><?php echo $this->__('Amount') ?></th>
                </tr></thead>
                <tbody>
                    <?php foreach ($card['rows'] as $r): $isRefund = in_array($r['kind'], array('refund', 'refund_offline'), true); ?>
                    <tr>
                        <td><?php echo $this->escapeHtml($r['date']) ?></td>
                        <td><?php echo $this->escapeHtml($r['time']) ?></td>
                        <td<?php if (!in_array($r['kind'], array('capture', 'refund'), true)): ?> class="ysd-muted"<?php endif; ?>><?php echo $this->escapeHtml($labels[$r['kind']]) ?></td>
                        <td><a href="<?php echo $this->getOrderUrl($r['order_id']) ?>"><?php echo $this->escapeHtml($r['order_no']) ?></a></td>
                        <td><a href="<?php echo $this->getDocUrl($r) ?>"><?php echo $this->escapeHtml($r['doc']) ?></a></td>
                        <td><?php echo $this->escapeHtml($r['txn']) ?></td>
                        <td class="a-right<?php if ($isRefund): ?> ysd-neg<?php endif; ?>"><?php echo $isRefund ? $neg($r['amount']) : $m($r['amount']) ?></td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table></div>
        </details>
        <?php endif; ?>
    </div>
</div>

<script type="text/javascript">
//<![CDATA[
    Calendar.setup({ inputField: 'date_from', ifFormat: '%Y-%m-%d', button: 'date_from_trig', align: 'Bl', singleClick: true });
    Calendar.setup({ inputField: 'date_to', ifFormat: '%Y-%m-%d', button: 'date_to_trig', align: 'Bl', singleClick: true });
    function ysdFmt(d) {
        return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
    }
    function ysdApplyPeriod() {
        var p = $('period_select').value, t = new Date(), from, to;
        if (!p) { return; }
        switch (p) {
            case 'today': from = to = t; break;
            case 'yesterday': from = to = new Date(t.getFullYear(), t.getMonth(), t.getDate() - 1); break;
            case 'current_month': from = new Date(t.getFullYear(), t.getMonth(), 1); to = t; break;
            case 'last_month': from = new Date(t.getFullYear(), t.getMonth() - 1, 1); to = new Date(t.getFullYear(), t.getMonth(), 0); break;
            case 'current_year': from = new Date(t.getFullYear(), 0, 1); to = t; break;
            case 'last_year': from = new Date(t.getFullYear() - 1, 0, 1); to = new Date(t.getFullYear() - 1, 11, 31); break;
        }
        $('date_from').value = ysdFmt(from);
        $('date_to').value = ysdFmt(to);
        $('ysd-filters').submit();
    }
//]]>
</script>
