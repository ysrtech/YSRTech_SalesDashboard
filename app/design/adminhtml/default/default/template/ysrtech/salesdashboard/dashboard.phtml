<script type="text/javascript">
//<![CDATA[
    // Initialize date pickers with calendar icons
    Calendar.setup({
        inputField: 'date_from',
        ifFormat: '%Y-%m-%d',
        button: 'date_from_trig',
        align: 'Bl',
        singleClick: true
    });
    
    Calendar.setup({
        inputField: 'date_to',
        ifFormat: '%Y-%m-%d',
        button: 'date_to_trig',
        align: 'Bl',
        singleClick: true
    });
    
    // Apply pre-selected period
    function applyPeriod() {
        var period = $('period_select').value;
        if (!period) return;
        
        var today = new Date();
        var fromDate, toDate;
        
        switch(period) {
            case 'current_month':
                fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
                toDate = today;
                break;
                
            case 'last_month':
                fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                toDate = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
                
            case 'current_year':
                fromDate = new Date(today.getFullYear(), 0, 1);
                toDate = today;
                break;
                
            case 'last_year':
                fromDate = new Date(today.getFullYear() - 1, 0, 1);
                toDate = new Date(today.getFullYear() - 1, 11, 31);
                break;
                
            case 'two_years':
                fromDate = new Date(today.getFullYear() - 2, today.getMonth(), today.getDate());
                toDate = today;
                break;
                
            case 'three_years':
                fromDate = new Date(today.getFullYear() - 3, today.getMonth(), today.getDate());
                toDate = today;
                break;
        }
        
        if (fromDate && toDate) {
            $('date_from').value = formatDate(fromDate);
            $('date_to').value = formatDate(toDate);
            refreshDashboard();
        }
    }
    
    // Format date as YYYY-MM-DD
    function formatDate(date) {
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');
        return year + '-' + month + '-' + day;
    }
    
    // Polyfill for padStart if not available
    if (!String.prototype.padStart) {
        String.prototype.padStart = function(targetLength, padString) {
            targetLength = targetLength >> 0;
            padString = String(typeof padString !== 'undefined' ? padString : ' ');
            if (this.length >= targetLength) {
                return String(this);
            } else {
                targetLength = targetLength - this.length;
                if (targetLength > padString.length) {
                    padString += padString.repeat(targetLength / padString.length);
                }
                return padString.slice(0, targetLength) + String(this);
            }
        };
    }
    
    // Refresh dashboard data via AJAX
    function refreshDashboard() {
        var fromDate = $('date_from').value;
        var toDate = $('date_to').value;
        var groupingAttribute = $('grouping_attribute_select').value;
        
        if (!fromDate || !toDate) {
            alert('<?php echo $this->__('Please select both From and To dates.') ?>');
            return;
        }
        
        new Ajax.Request('<?php echo $this->getRefreshUrl() ?>', {
            method: 'post',
            parameters: {
                from: fromDate,
                to: toDate,
                grouping_attribute: groupingAttribute,
                form_key: FORM_KEY
            },
            onSuccess: function(transport) {
                if (transport.responseText.isJSON()) {
                    var response = transport.responseText.evalJSON();
                    
                    // Update the sales totals display
                    if ($('order-count')) {
                        $('order-count').update(response.order_count);
                    }
                    if ($('total-items-shipped')) {
                        $('total-items-shipped').update(response.total_items_shipped);
                    }
                    if ($('total-sales-without-shipping')) {
                        $('total-sales-without-shipping').update(response.total_sales_without_shipping);
                    }
                    if ($('total-shipping')) {
                        $('total-shipping').update(response.total_shipping);
                    }
                    if ($('total-tax-line')) {
                        $('total-tax-line').update(response.total_tax_display);
                    }
                    if ($('total-sales-with-shipping')) {
                        $('total-sales-with-shipping').update('<strong style="font-size: 1.2em; color: #006400;">' + response.total_sales_with_shipping + '</strong>');
                    }
                    if ($('total-refunded')) {
                        $('total-refunded').update('<strong style="color: #cc0000;">-' + response.total_refunded + '</strong>');
                    }
                    
                    // Update tax breakdown
                    if ($('tax-breakdown-body')) {
                        var taxBreakdownHtml = '';
                        if (response.taxes_by_zone && response.taxes_by_zone.length > 0) {
                            response.taxes_by_zone.each(function(tax) {
                                taxBreakdownHtml += '<tr><td>' + tax.identifier.escapeHTML() + '</td><td class="a-right">' + tax.amount + '</td></tr>';
                            });
                            if (response.federal_tax_raw && response.federal_tax_raw > 0) {
                                taxBreakdownHtml += '<tr style="border-top: 1px solid #ccc;"><td><strong><?php echo $this->__('Federal Tax Subtotal') ?></strong></td><td class="a-right" id="federal-tax"><strong>' + response.federal_tax + '</strong></td></tr>';
                            }
                            taxBreakdownHtml += '<tr style="border-top: 2px solid #ccc;"><td><strong><?php echo $this->__('Total Tax') ?></strong></td><td class="a-right" id="total-tax"><strong style="font-size: 1.1em;">' + response.total_tax + '</strong></td></tr>';
                        } else {
                            taxBreakdownHtml = '<tr><td colspan="2" class="a-center"><?php echo $this->__('No tax data available for this period.') ?></td></tr>';
                        }
                        $('tax-breakdown-body').update(taxBreakdownHtml);
                    }
                    
                    // Update products by attribute
                    if ($('products-by-attribute-body')) {
                        var productsHtml = '';
                        if (response.products_by_attribute && response.products_by_attribute.length > 0) {
                            response.products_by_attribute.each(function(product) {
                                productsHtml += '<tr><td>' + product.attribute.escapeHTML() + '</td><td class="a-right">' + product.qty + '</td><td class="a-right">' + product.amount + '</td></tr>';
                            });
                        } else {
                            productsHtml = '<tr><td colspan="3" class="a-center"><?php echo $this->__('No product data available for this period.') ?></td></tr>';
                        }
                        $('products-by-attribute-body').update(productsHtml);
                    }
                } else {
                    alert('<?php echo $this->__('Error loading data. Please try again.') ?>');
                }
            },
            onFailure: function() {
                alert('<?php echo $this->__('Error loading data. Please try again.') ?>');
            }
        });
    }
//]]>
</script>

